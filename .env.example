# ─────────────────────────────────────────────────────────────
# Ebonímode environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are sent to the browser: never put secrets there.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=            # international format, digits only, e.g. 234XXXXXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # the publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_SERVICE_ROLE_KEY=              # server only

# Cloudinary (images and video)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # unsigned, narrowly restricted preset for the admin widget
CLOUDINARY_API_KEY=                     # server only
CLOUDINARY_API_SECRET=                  # server only

# Payments: set these as Supabase Edge Function secrets (supabase secrets set ...)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_API_VERSION=v3
INSTALLMENT_PROVIDER_SECRET_KEY=        # CredPal / Easybuy / TBC

# Email
RESEND_API_KEY=                         # server only
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

# Virtual try-on (Genlook)
GENLOOK_API_KEY=                        # server only
NEXT_PUBLIC_TRYON_ENABLED=false         # site-wide kill switch

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Error tracking
SENTRY_DSN=
